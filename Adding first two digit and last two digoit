import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int a=sc.nextInt();
        if(a<999){
            System.out.println("Invalid");
        }
        else{
            int l=a%100;
            int b=a;
            while(b>99){
                b=b/10;
            }
        System.out.println(l+b);
        }
    }
}
