import java.util.*;
public class Main 
{
    public static void main(String[] args) 
    {
        Scanner scan = new Scanner(System.in);
        int a=scan.nextInt();
        if(a%2==0) {
            System.out.println("Is Even");
        }
        else
        {
            System.out.println("Is Odd");
        }
    }
}
